# Choose "real" for normal data or "demo" for the disposable seeded company.
DATABASE_MODE=real

# Keep the URLs separate so changing modes never overwrites either database.
DATABASE_URL=postgresql+psycopg:///policy_assignments
DEMO_DATABASE_URL=postgresql+psycopg:///policy_assignments_demo

# Generate each secret independently with: openssl rand -hex 32
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-random-secret
AUTH_ROOT_RECOVERY_KEY=replace-with-a-random-secret
CHANGE_APPROVAL_SECRET=replace-with-a-random-secret
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-secret

AUTH_BOOTSTRAP_SUBJECT=local-admin
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_REAUTH_TTL_SECONDS=600
AUTH_REQUIRE_PRIVILEGED_MFA=true

# User-bound agent access. These public URLs must match the deployed backend,
# frontend authorization page, and MCP endpoint exactly.
OAUTH_ISSUER_URL=http://127.0.0.1:8000
OAUTH_AUTHORIZATION_URL=http://localhost:3000/oauth/authorize
MCP_PUBLIC_URL=http://127.0.0.1:8001/mcp
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_CODE_TTL_SECONDS=300

# Local development only. Disable this outside a trusted development machine.
AUTH_PASSWORD_RESET_EXPOSE_TOKEN=true

CORS_ALLOWED_ORIGINS=http://localhost:3000
